---
import type { Crumb } from '../lib/schema';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="container-site pt-4 text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-ink-soft">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i < crumbs.length - 1 ? (
          <a href={c.href} class="text-ink-soft underline">{c.name}</a>
        ) : (
          <span aria-current="page" class="font-medium text-ink">{c.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
