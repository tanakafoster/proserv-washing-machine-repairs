---
/**
 * Inline icon set (no icon font, no JS). Paths and licences are in ./icons.ts.
 * Icons are decorative: the text beside them carries the meaning, so they're hidden from screen readers.
 */
import { stroke, fill, type IconName } from './icons';
interface Props {
  name: IconName;
  class?: string;
  /** Line width for the outline icons (Lucide default 2). */
  strokeWidth?: number;
}
const { name, class: cls = 'h-5 w-5', strokeWidth = 2 } = Astro.props;
const isFill = name in fill;
const body = isFill ? fill[name as keyof typeof fill] : stroke[name as keyof typeof stroke];
---
{isFill ? (
  <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" set:html={body} />
) : (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={body} />
)}
