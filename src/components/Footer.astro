---
import Logo from './Logo.astro';
import { site, telHref, whatsappHref, mailHref, areaUrl, hoursText } from '../data/site';
import { services, serviceUrl } from '../data/services';
import { trademarkNote } from '../data/brands';
const year = new Date().getFullYear();
const reviewHref = site.googleReviewUrl || '/contact/';
---
<footer class="border-t-4 border-brand bg-surface pb-20 text-ink">
  <div class="container-site grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <Logo class="h-11 w-auto" />
      <p class="mt-4 text-sm text-ink-soft">Mobile washing machine repairs at your door across Gauteng. We repair all major washing machine brands.</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={telHref} data-track="call" class="font-semibold">{site.phone.display}</a></li>
        <li><a href={whatsappHref} target="_blank" rel="noopener" data-track="whatsapp">WhatsApp {site.phone.display}</a></li>
        <li><a href={mailHref} class="break-all">{site.email}</a></li>
        <li class="text-ink-soft">{hoursText()}</li>
        <li class="text-ink-soft">{site.hoursNote}</li>
      </ul>
    </div>
    <nav aria-labelledby="f-areas">
      <h2 id="f-areas" class="font-semibold">Areas we cover</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {site.areas.map((a) => <li><a href={areaUrl(a.slug)}>Washing machine repairs {a.name}</a></li>)}
        <li><a href="/areas/">All service areas</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="f-services">
      <h2 id="f-services" class="font-semibold">Services</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {services.map((s) => <li><a href={serviceUrl(s.slug)}>{s.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-labelledby="f-quick">
      <h2 id="f-quick" class="font-semibold">Quick links</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/problems/">Common problems</a></li>
        <li><a href="/brands/">Brands we repair</a></li>
        <li><a href="/error-codes/">Error code guides</a></li>
        <li><a href="/washing-machine-repair-cost/">Repair prices</a></li>
        <li><a href="/repair-or-replace/">Repair or replace?</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/about/">About us</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Contact and bookings</a></li>
        <li><a href="/privacy-policy/">Privacy policy</a></li>
        <li><a href={reviewHref} {...(site.googleReviewUrl ? { target: '_blank', rel: 'noopener' } : {})}>Leave us a Google review{site.googleReviewUrl ? '' : ' [GBP REVIEW LINK]'}</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="container-site py-5 text-xs text-ink-soft">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="mt-2">{trademarkNote}</p>
    </div>
  </div>
</footer>
