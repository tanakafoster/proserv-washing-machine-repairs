---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, telHref, mainNav } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
---
<header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="/" class="shrink-0 no-underline" aria-label="ProServ Washing Machine Repairs home">
      <Logo class="h-9 w-auto md:h-11" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-5 text-[0.95rem] font-medium">
        {mainNav.map((n) => (
          <li><a href={n.href} class:list={['text-ink no-underline hover:text-brand-dark', isActive(n.href) && 'text-brand-dark']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={telHref} class="btn btn-primary hidden md:inline-flex" data-track="call">
        <Icon name="phone" /> {site.phone.display}
      </a>
      <details class="relative lg:hidden" id="mobile-menu">
        <summary class="btn btn-outline min-h-11 list-none px-3 py-2 [&::-webkit-details-marker]:hidden" aria-label="Open menu">
          <svg class="h-6 w-6" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="sr-only">Menu</span>
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-2 w-64 rounded-xl border border-line bg-white p-2 shadow-xl">
          <ul>
            <li><a href="/" class="block rounded-lg px-3 py-3 text-ink no-underline hover:bg-surface">Home</a></li>
            {mainNav.map((n) => (
              <li><a href={n.href} class="block rounded-lg px-3 py-3 text-ink no-underline hover:bg-surface">{n.label}</a></li>
            ))}
            <li><a href="/about/" class="block rounded-lg px-3 py-3 text-ink no-underline hover:bg-surface">About us</a></li>
            <li><a href="/faq/" class="block rounded-lg px-3 py-3 text-ink no-underline hover:bg-surface">FAQ</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
