---
import ContactButtons from './ContactButtons.astro';
import { site, hoursText } from '../data/site';
interface Props { heading?: string; text?: string }
const {
  heading = 'Washing machine broken? Let\'s get it fixed.',
  text = `Call or WhatsApp now and we'll book a technician to come to you. You'll get a quote before any work starts.`,
} = Astro.props;
---
<section class="bg-ink py-12 text-white sm:py-16" aria-labelledby="cta-h">
  <div class="container-site text-center">
    <h2 id="cta-h" class="text-2xl font-bold sm:text-3xl">{heading}</h2>
    <p class="mx-auto mt-3 max-w-2xl text-gray-200">{text}</p>
    <ContactButtons class="mt-6 justify-center" size="lg" />
    <p class="mt-4 text-sm text-gray-300">{hoursText()} · {site.email}</p>
  </div>
</section>
