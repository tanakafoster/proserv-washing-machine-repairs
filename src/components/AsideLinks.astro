---
/**
 * Small sidebar card of related links (icon, title and an optional line of text per link), for the
 * `aside` slot of LongFormSection. Its heading is an <h2> so it sits in the page outline.
 *   <AsideLinks heading="Get it fixed" items={[{ href: '/services/…/', title: '…', text: '…', icon: 'washer' }]} />
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';
interface Item { href: string; title: string; text?: string; icon?: IconName }
interface Props { heading: string; intro?: string; items: Item[]; class?: string }
const { heading, intro, items, class: cls = '' } = Astro.props;
---
<div class:list={['card-surface p-5', cls]}>
  <h2 class="type-h3 text-lg">{heading}</h2>
  {intro && <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{intro}</p>}
  <ul class="mt-3 -mx-2 space-y-1">
    {items.map((i) => (
      <li>
        <a href={i.href} class="group flex min-h-12 items-center gap-3 rounded-xl px-2 py-2 text-ink no-underline hover:bg-surface hover:text-ink">
          <span class="icon-tile h-10 w-10 rounded-lg"><Icon name={i.icon ?? 'arrow'} class="h-5 w-5" /></span>
          <span class="min-w-0 flex-1 leading-snug">
            <span class="block text-[15px] font-bold text-ink-strong">{i.title}</span>
            {i.text && <span class="mt-0.5 block text-sm text-ink-soft">{i.text}</span>}
          </span>
          <Icon name="chevron-right" class="h-4 w-4 shrink-0 text-brand transition-transform group-hover:translate-x-0.5" />
        </a>
      </li>
    ))}
  </ul>
  <slot />
</div>
