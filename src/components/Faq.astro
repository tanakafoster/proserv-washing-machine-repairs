---
import type { FaqItem } from '../data/types';
interface Props { items: FaqItem[]; heading?: string; id?: string }
const { items, heading = 'Frequently asked questions', id = 'faq' } = Astro.props;
---
<section class="section section-alt" aria-labelledby={`${id}-h`}>
  <div class="container-site max-w-3xl">
    <h2 id={`${id}-h`} class="text-2xl font-bold sm:text-3xl">{heading}</h2>
    <div class="mt-6 space-y-3">
      {items.map((item) => (
        <details class="group rounded-lg border border-line bg-white p-4">
          <summary class="flex items-start justify-between gap-4 font-semibold">
            <span set:html={item.q} />
            <span class="text-brand-dark transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="mt-3 text-ink-soft" set:html={item.a} />
        </details>
      ))}
    </div>
  </div>
</section>
