---
import Icon from './Icon.astro';
interface Item { href: string; title: string; text?: string }
interface Props { items: Item[]; heading?: string; headingId?: string; cols?: 2 | 3 | 4; alt?: boolean; intro?: string }
const { items, heading, headingId = 'links-h', cols = 3, alt = false, intro } = Astro.props;
const grid = { 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-2 lg:grid-cols-3', 4: 'sm:grid-cols-2 lg:grid-cols-4' }[cols];
---
<section class:list={['section', alt && 'section-alt']} aria-labelledby={heading ? headingId : undefined}>
  <div class="container-site">
    {heading && <h2 id={headingId} class="text-2xl font-bold sm:text-3xl">{heading}</h2>}
    {intro && <p class="mt-3 max-w-3xl text-ink-soft">{intro}</p>}
    <ul class={`mt-6 grid gap-4 ${grid}`}>
      {items.map((i) => (
        <li>
          <a href={i.href} class="card-link h-full">
            <span class="flex items-center justify-between gap-2 font-semibold text-ink">{i.title}<span class="text-brand-dark"><Icon name="arrow" /></span></span>
            {i.text && <span class="mt-1 block text-sm text-ink-soft">{i.text}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
