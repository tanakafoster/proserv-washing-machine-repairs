---
/**
 * Text-based wordmark. Its colours come from the @theme block in src/styles/global.css.
 * Replace with your own logo later: swap this SVG (and public/logo.svg + public/logo.png,
 * used by schema and social cards).
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={cls} viewBox="0 0 220 44" width="220" height="44" role="img" aria-label="ProServ Washing Machine Repairs" xmlns="http://www.w3.org/2000/svg">
  <rect x="0" y="4" width="36" height="36" rx="9" class="fill-brand" />
  <circle cx="18" cy="22" r="10" fill="none" stroke-width="3" class="stroke-ink-strong" />
  <circle cx="18" cy="22" r="4" class="fill-ink-strong" />
  <text x="44" y="26" font-family="'Geist Variable', Arial, sans-serif" font-size="23" font-weight="900" letter-spacing="-0.6" class="fill-ink-strong">Pro<tspan class="fill-brand-dark">Serv</tspan></text>
  <text x="45" y="40" font-family="'Geist Variable', Arial, sans-serif" font-size="9" font-weight="700" letter-spacing="1.1" class="fill-ink-soft">WASHING MACHINE REPAIRS</text>
</svg>
