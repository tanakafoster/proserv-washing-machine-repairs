---
/**
 * The site email address with a soft break after the "@", so on a narrow phone it wraps as
 * "info@" / "domain" instead of breaking in the middle of a word. Use it inside a mailto link.
 */
import { site } from '../data/site';
const at = site.email.indexOf('@');
const local = at > 0 ? site.email.slice(0, at + 1) : site.email;
const domain = at > 0 ? site.email.slice(at + 1) : '';
---
{local}{domain && <wbr />}{domain}
