---
import { site, telHref, whatsappHref } from '../data/site';
import Icon from './Icon.astro';
interface Props {
  class?: string;
  size?: 'md' | 'lg';
  /** Stretch both buttons to the full width on phones (default) or always. */
  block?: 'phone' | 'always';
  /** Label for the call button. Defaults to "Call <number>". */
  callLabel?: string;
}
const { class: cls = '', size = 'md', block = 'phone', callLabel = `Call ${site.phone.display}` } = Astro.props;
const sizeCls = size === 'lg' ? 'btn-lg' : '';
const widthCls = block === 'always' ? 'w-full' : 'w-full sm:w-auto';
---
<div class:list={['grid gap-3', block === 'always' ? '' : 'sm:flex sm:flex-wrap', cls]}>
  <a href={telHref} class:list={['btn btn-primary', sizeCls, widthCls]} data-track="call">
    <Icon name="phone" /> {callLabel}
  </a>
  <a href={whatsappHref} class:list={['btn btn-whatsapp', sizeCls, widthCls]} target="_blank" rel="noopener" data-track="whatsapp">
    <Icon name="whatsapp" /> WhatsApp us<span class="sr-only"> (opens in a new tab)</span>
  </a>
</div>
