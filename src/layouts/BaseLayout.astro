---
import '../styles/global.css';
import themeCss from '../styles/global.css?raw';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
import { businessSchema, websiteSchema, breadcrumbSchema, type Crumb } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Breadcrumb trail excluding Home. Omit on the home page. */
  crumbs?: Crumb[];
  /** Extra JSON-LD nodes for this page (Service, FAQPage, BlogPosting...). */
  schema?: object[];
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Preload the LCP image (hero). */
  preloadImage?: { src: string; srcset?: string; sizes?: string };
  article?: { published: Date; modified: Date };
  /** The 404 page: it has no URL of its own, so no canonical or og:url. */
  notFound?: boolean;
}

const { title, description, crumbs, schema = [], noindex = false, ogImage = '/images/og-default.jpg', ogType = 'website', preloadImage, article, notFound = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
const fullCrumbs: Crumb[] | undefined = crumbs ? [{ name: 'Home', href: '/' }, ...crumbs] : undefined;

const graph = [businessSchema(), websiteSchema(), ...(fullCrumbs ? [breadcrumbSchema(fullCrumbs)] : []), ...schema];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');

const gtmReady = /^GTM-[A-Z0-9]+$/.test(site.gtmId) && site.gtmId !== 'GTM-XXXXXXX';
// Browser theme colour follows --color-brand-dark in global.css.
const themeColor = themeCss.match(/--color-brand-dark:\s*(#[0-9a-fA-F]{3,8})/)?.[1]?.toUpperCase() ?? '#C2410C';
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!notFound && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />
    )}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:modified_time" content={article.modified.toISOString()} />}

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={themeColor} />

    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Analytics: dataLayer events call_click, whatsapp_click, form_submit (see README) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        if (href.indexOf('tel:') === 0) {
          window.dataLayer.push({ event: 'call_click', link_url: href, page_path: location.pathname });
        } else if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp') !== -1) {
          window.dataLayer.push({ event: 'whatsapp_click', link_url: href, page_path: location.pathname });
        }
      });
    </script>
    {gtmReady && (
      <script is:inline define:vars={{ gtmId: site.gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
      </script>
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    {gtmReady && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    )}
    <a href="#main" class="sr-only rounded-xl bg-white px-4 py-3 font-semibold text-ink-strong no-underline shadow-lg focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70]">Skip to content</a>
    <Header />
    <main id="main" class="relative isolate flex-1">
      <div class="page-glow" aria-hidden="true"></div>
      {fullCrumbs && <Breadcrumbs crumbs={fullCrumbs} />}
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
    <WhatsAppFloat />
  </body>
</html>
