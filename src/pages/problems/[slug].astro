---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LongFormSection from '../../components/LongFormSection.astro';
import AsideLinks from '../../components/AsideLinks.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import LinkCards from '../../components/LinkCards.astro';
import { serviceIcon, problemIcon } from '../../components/icon-maps';
import { problems, problemUrl, type Problem } from '../../data/problems';
import { serviceBySlug, serviceUrl } from '../../data/services';
import { faqSchema } from '../../lib/schema';

export function getStaticPaths() {
  return problems.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Problem };
const path = problemUrl(p.slug);
const service = serviceBySlug(p.serviceSlug)!;
const others = problems.filter((o) => o.slug !== p.slug);
---
<BaseLayout
  title={p.title}
  description={p.description}
  crumbs={[{ name: 'Problems', href: '/problems/' }, { name: p.name, href: path }]}
  schema={[faqSchema(p.faqs)]}
>
  <PageHero h1={p.h1} intro={p.intro} eyebrow="Common washing machine problems" />
  <LongFormSection reservedIds={['other-problems']}>
    <Fragment set:html={p.body} />
    <Fragment slot="aside">
      <AsideLinks
        heading="Get it fixed"
        items={[
          { href: serviceUrl(service.slug), title: service.name, text: 'The service that usually handles this fault', icon: serviceIcon(service.slug) },
          { href: '/error-codes/', title: 'Error code guides', text: 'Error code on the display? See what it means', icon: 'alert' },
        ]}
      />
    </Fragment>
  </LongFormSection>
  <LinkCards
    alt
    eyebrow="Fault guides"
    heading="Other washing machine problems"
    headingId="other-problems"
    cols={4}
    items={others.map((o) => ({ href: problemUrl(o.slug), title: o.name, text: o.summary, icon: problemIcon(o.slug) }))}
  />
  <Faq items={p.faqs} tone="white" />
  <CtaBand heading="Still not working? We'll come to you." />
</BaseLayout>
