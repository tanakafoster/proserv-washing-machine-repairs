---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LongFormSection from '../../components/LongFormSection.astro';
import LinkCards from '../../components/LinkCards.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, areaUrl, areaList } from '../../data/site';
import { areaContent } from '../../data/areas';
const f = site.facts;
---
<BaseLayout
  title="Washing Machine Repairs Gauteng: Areas | ProServ"
  description={`Washing machine repairs across Gauteng: ${areaList()}. Call ${site.phone.display}.`}
  crumbs={[{ name: 'Areas', href: '/areas/' }]}
>
  <PageHero
    h1="Washing machine repairs across Gauteng"
    eyebrow="Areas we cover"
    intro={`<p>ProServ provides mobile washing machine repairs across Gauteng. Our technicians drive to you, so there's no need to take your machine anywhere. We cover ${areaList()}, plus many suburbs in between [CONFIRM]. Choose your area below for local details and the suburbs we work in.</p>`}
  />
  <LinkCards alt eyebrow="Areas we cover" heading="Choose your area" headingId="area-list" icon="map" items={site.areas.map((a) => ({ href: areaUrl(a.slug), title: `Washing machine repairs ${a.name}`, text: areaContent[a.slug]?.suburbs.slice(0, 4).join(', ') + '…' }))} />
  <LongFormSection reservedIds={['area-list']}>
      <h2>How our mobile service works</h2>
      <p>You call or WhatsApp us, we book a time, and a technician comes to your home with the most common parts on the van. We aim to arrive {f.arrivalTime} on urgent call-outs, depending on where the technician is working. The technician diagnoses the fault and quotes before starting. The call-out fee is {f.calloutFee}, {f.calloutCondition}.</p>
      <h2>Not sure if we cover your suburb?</h2>
      <p>If your suburb isn't listed on an area page, ask us anyway. We often work in neighbouring suburbs, and we'll tell you straight away if you're outside our area.</p>
      <h2>Access, estates and complexes</h2>
      <p>Many Gauteng homes are in estates or complexes with access control. When you book, send us your gate instructions or register our technician with security. For flats, tell us about parking, lifts and stairs. It helps us arrive on time and keeps the visit short.</p>
      <h2>What we repair</h2>
      <p>We repair all major washing machine brands in every area we cover. See our <a href="/services/">washing machine repair services</a> and the <a href="/brands/">brands we repair</a>.</p>
  </LongFormSection>
  <CtaBand />
</BaseLayout>
