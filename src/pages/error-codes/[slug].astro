---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LongFormSection from '../../components/LongFormSection.astro';
import AsideLinks from '../../components/AsideLinks.astro';
import ErrorCodeTable from '../../components/ErrorCodeTable.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import LinkCards from '../../components/LinkCards.astro';
import { errorGuides, type ErrorGuide } from '../../data/errorCodes';
import { brandUrl, errorCodeUrl } from '../../data/site';
import { faqSchema } from '../../lib/schema';

export function getStaticPaths() {
  return errorGuides.map((g) => ({ params: { slug: `${g.slug}-washing-machine-error-codes` }, props: { g } }));
}
const { g } = Astro.props as { g: ErrorGuide };
const path = errorCodeUrl(g.slug);
const others = errorGuides.filter((o) => o.slug !== g.slug);
---
<BaseLayout
  title={g.title}
  description={g.description}
  crumbs={[{ name: 'Error codes', href: '/error-codes/' }, { name: g.brand, href: path }]}
  schema={[faqSchema(g.faqs)]}
>
  <PageHero h1={g.h1} intro={g.intro} eyebrow="Error code guides" />
  <LongFormSection reservedIds={['codes-h', 'stop-h', 'other-guides']} toc>
    <Fragment set:html={g.body} />
    {/* Order: explanations and safe checks (body), the code table, technician codes and the visit
        (bodyAfterTable), when to stop, then "If your code isn't listed" and booking (closing). */}
    <Fragment slot="after">
      <section aria-labelledby="codes-h">
        <div class="prose-site"><h2 id="codes-h">Common {g.brand} washing machine error codes</h2></div>
        <ErrorCodeTable brand={g.brand} codes={g.codes} sources={g.sources} />
      </section>
      <div class="prose-site mt-12" set:html={g.bodyAfterTable} />
      <div class="prose-site mt-12" data-shared="error-guide-stop">
        <h2 id="stop-h">When to stop and call a technician</h2>
        <p>Stop using the machine and call us if a code keeps coming back after the simple checks, if there's water on the floor, a burning smell, or the machine trips the electricity. Codes that point to heating, sensors, the motor or the control board involve electrical parts, so please leave those to a technician.</p>
        <p>WhatsApp us a photo of the display and the model number and we'll tell you what the code usually means on that model. For the full picture, see <a href={brandUrl(g.brandSlug)}>{g.brand} washing machine repairs</a>, or read our general guide to a <a href="/problems/washing-machine-showing-error-code/">washing machine showing an error code</a>.</p>
      </div>
      <div class="prose-site mt-12" set:html={g.closing} />
    </Fragment>
    <Fragment slot="aside">
      <AsideLinks
        heading="Related help"
        items={[
          { href: brandUrl(g.brandSlug), title: `${g.brand} washing machine repairs`, icon: 'washer' },
          { href: '/problems/washing-machine-showing-error-code/', title: 'Washing machine showing an error code', icon: 'alert' },
        ]}
      />
    </Fragment>
  </LongFormSection>
  <LinkCards
    alt
    cols={3}
    eyebrow="More guides"
    heading="Other error code guides"
    headingId="other-guides"
    icon="alert"
    items={others.map((o) => ({ href: errorCodeUrl(o.slug), title: `${o.brand} washing machine error codes`, text: o.summary }))}
  />
  <Faq items={g.faqs} heading={`${g.brand} error code questions`} tone="white" />
  <CtaBand heading={`${g.brand} error code won't clear?`} />
</BaseLayout>
