---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactButtons from '../components/ContactButtons.astro';
import TrustBar from '../components/TrustBar.astro';
import HowItWorks from '../components/HowItWorks.astro';
import LinkCards from '../components/LinkCards.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site, areaUrl, brandUrl, hoursText } from '../data/site';
import { services, serviceUrl } from '../data/services';
import { problems, problemUrl } from '../data/problems';
import { brands, otherBrands, trademarkNote } from '../data/brands';
import { faqSchema } from '../lib/schema';

const f = site.facts;
const hero = {
  src: '/images/hero-technician.webp',
  srcset: '/images/hero-technician-640.webp 640w, /images/hero-technician.webp 1200w',
  sizes: '(min-width: 1024px) 540px, 100vw',
};
const faqs = [
  { q: 'How much is the call-out fee?', a: `The call-out fee is ${f.calloutFee}. It is ${f.calloutCondition}. If you go ahead, you only pay for the repair.` },
  { q: 'How quickly can you get here?', a: `We aim to arrive ${f.arrivalTime} on urgent call-outs, depending on where the technician is working. Otherwise we book a time that suits you.` },
  { q: 'Do you repair all brands?', a: 'We repair all major washing machine brands, including Defy, LG, Samsung, Bosch, Whirlpool, Hisense, AEG, Siemens, Miele, Smeg, Electrolux and Speed Queen. We are an independent repairer, not an agent for any brand.' },
  { q: 'Are your repairs guaranteed?', a: `Yes. Every repair carries our ${f.warranty} warranty on parts and labour.` },
  { q: 'Do I need to take my machine anywhere?', a: 'No. We repair washing machines at your home. In the rare case that a workshop repair is needed, we will discuss it with you first.' },
  { q: 'How do I pay?', a: '[CONFIRM: payment methods, e.g. EFT, card, cash] Payment is due when the repair is complete.' },
];
---
<BaseLayout
  title="Washing Machine Repairs at Your Door | ProServ"
  description="Washing machine repairs at your door across Gauteng. All major brands, quote before work starts. Call or WhatsApp ProServ on 079 895 0496."
  schema={[faqSchema(faqs)]}
  preloadImage={hero}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-tint to-white">
    <div class="container-site grid items-center gap-8 py-8 sm:py-12 lg:grid-cols-[1.1fr_1fr] lg:py-16">
      <div>
        <p class="eyebrow">Gauteng's mobile washing machine technicians</p>
        <h1 class="mt-2 text-4xl leading-tight font-extrabold sm:text-5xl">Washing machine repairs at your door</h1>
        <p class="mt-4 max-w-xl text-lg text-ink-soft">
          Washing machine broken? ProServ sends a washing machine technician to your home to diagnose the problem, quote before any work, and fix most faults on the spot. We repair all major washing machine brands across {site.areas.map((a) => a.name).join(', ')}.
        </p>
        <ContactButtons class="mt-6" size="lg" />
        <ul class="mt-6 grid gap-2 text-ink-soft sm:grid-cols-2">
          <li class="flex items-center gap-2"><span class="text-brand-dark"><Icon name="check" /></span> Quote before we start</li>
          <li class="flex items-center gap-2"><span class="text-brand-dark"><Icon name="check" /></span> {f.calloutFee} call-out, only if you decline</li>
          <li class="flex items-center gap-2"><span class="text-brand-dark"><Icon name="check" /></span> {f.warranty} repair warranty</li>
          <li class="flex items-center gap-2"><span class="text-brand-dark"><Icon name="check" /></span> Front, top and washer-dryers</li>
        </ul>
      </div>
      <img
        src={hero.src}
        srcset={hero.srcset}
        sizes={hero.sizes}
        width="1200"
        height="900"
        alt="ProServ technician repairing a front loader washing machine in a customer's kitchen"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="h-auto w-full rounded-2xl border border-line object-cover shadow-md"
      />
    </div>
  </section>

  <TrustBar />

  <!-- Services -->
  <LinkCards
    heading="Washing machine repair services"
    headingId="services-h"
    intro="Whatever kind of machine you have, we'll come to you and fix it properly."
    items={services.map((s) => ({ href: serviceUrl(s.slug), title: s.name, text: s.summary }))}
  />

  <!-- Brands (text only, no logos) -->
  <section class="section section-alt" aria-labelledby="brands-h">
    <div class="container-site">
      <h2 id="brands-h" class="text-2xl font-bold sm:text-3xl">We repair all major washing machine brands</h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {brands.map((b) => (
          <li><a href={brandUrl(b.slug)} class="inline-block rounded-full border border-line bg-white px-4 py-2 font-semibold text-ink no-underline hover:border-brand">{b.brand}</a></li>
        ))}
        {otherBrands.map((b) => (
          <li><span class="inline-block rounded-full border border-line bg-white px-4 py-2 text-ink-soft">{b}</span></li>
        ))}
      </ul>
      <p class="mt-4 text-sm text-ink-soft">{trademarkNote} <a href="/brands/">See all brands</a>.</p>
    </div>
  </section>

  <HowItWorks />

  <!-- Problems -->
  <LinkCards
    alt
    heading="Common washing machine problems we fix"
    headingId="problems-h"
    cols={4}
    items={problems.map((p) => ({ href: problemUrl(p.slug), title: p.name, text: p.summary }))}
  />

  <!-- Why us / copy -->
  <section class="section" aria-labelledby="why-h">
    <div class="container-site grid gap-10 lg:grid-cols-2">
      <div class="prose-site">
        <h2 id="why-h">A local washing machine repair service you can trust</h2>
        <p>When your washing machine stops, life gets complicated fast. Laundry piles up, school uniforms don't get washed and the laundromat eats your weekend. We've built ProServ around getting you back to normal quickly, with no surprises on the bill.</p>
        <p>Our technicians have been doing washing machine repair work for {f.yearsInBusiness} years and have completed {f.repairsCompleted} repairs. We carry the most common parts on the van, so many machines are fixed on the first visit. We explain what's wrong in plain language, show you the faulty part, and give you a price before we start.</p>
        <p>If a machine isn't worth repairing, we'll say so. Our <a href="/repair-or-replace/">repair or replace guide</a> explains how we think about it, and our <a href="/washing-machine-repair-cost/">washing machine repair cost</a> page explains what affects the price.</p>
      </div>
      <div class="card self-start">
        <h3 class="text-xl font-semibold">What you can expect</h3>
        <ul class="mt-4 space-y-3">
          <li class="flex gap-3"><span class="text-brand-dark"><Icon name="check" /></span> A technician at your door, with a booked time</li>
          <li class="flex gap-3"><span class="text-brand-dark"><Icon name="check" /></span> A proper diagnosis, not a guess over the phone</li>
          <li class="flex gap-3"><span class="text-brand-dark"><Icon name="check" /></span> A clear quote before any work</li>
          <li class="flex gap-3"><span class="text-brand-dark"><Icon name="check" /></span> {f.calloutFee} call-out fee, {f.calloutCondition}</li>
          <li class="flex gap-3"><span class="text-brand-dark"><Icon name="check" /></span> {f.warranty} warranty on parts and labour</li>
          <li class="flex gap-3"><span class="text-brand-dark"><Icon name="check" /></span> {f.fiveStarReviews} five-star reviews from local customers</li>
        </ul>
        <p class="mt-4 text-sm text-ink-soft">{hoursText()}</p>
      </div>
    </div>
  </section>

  <!-- Areas -->
  <LinkCards
    alt
    heading="Areas we cover"
    headingId="areas-h"
    intro="Our mobile technicians cover these areas and the suburbs around them."
    items={site.areas.map((a) => ({ href: areaUrl(a.slug), title: `Washing machine repairs ${a.name}` }))}
  />

  <Faq items={faqs} />
  <CtaBand />
</BaseLayout>
