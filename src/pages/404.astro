---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactButtons from '../components/ContactButtons.astro';
---
<BaseLayout title="Page Not Found | ProServ" description="Sorry, that page doesn't exist. Find washing machine repair help or call ProServ on 079 895 0496." noindex>
  <section class="section">
    <div class="container-site max-w-2xl text-center">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-2 text-3xl font-extrabold sm:text-4xl">Sorry, we can't find that page</h1>
      <p class="mt-4 text-lg text-ink-soft">The page may have moved. Try one of these, or get in touch and we'll help with your washing machine.</p>
      <ul class="mt-6 flex flex-wrap justify-center gap-3">
        <li><a href="/" class="btn btn-outline">Home</a></li>
        <li><a href="/services/" class="btn btn-outline">Services</a></li>
        <li><a href="/problems/" class="btn btn-outline">Problems</a></li>
        <li><a href="/areas/" class="btn btn-outline">Areas</a></li>
      </ul>
      <ContactButtons class="mt-8 justify-center" />
    </div>
  </section>
</BaseLayout>
