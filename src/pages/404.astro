---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactButtons from '../components/ContactButtons.astro';
import { site } from '../data/site';
---
<BaseLayout title="Page Not Found | ProServ" description={`Sorry, that page doesn't exist. Find washing machine repair help or call ProServ on ${site.phone.display}.`} noindex notFound>
  <section class="section-y">
    <div class="container-site max-w-2xl text-center">
      <p class="type-eyebrow mb-3 justify-center">Error 404</p>
      <h1 class="type-page-h1">Sorry, we can't find that page</h1>
      <p class="type-lead mx-auto mt-5 max-w-xl">The page may have moved. Try one of these, or get in touch and we'll help with your washing machine.</p>
      <ul class="mt-8 flex flex-wrap justify-center gap-2.5">
        <li><a href="/" class="chip">Home</a></li>
        <li><a href="/services/" class="chip">Services</a></li>
        <li><a href="/problems/" class="chip">Problems</a></li>
        <li><a href="/areas/" class="chip">Areas</a></li>
      </ul>
      <ContactButtons class="mt-10 justify-center" size="lg" />
    </div>
  </section>
</BaseLayout>
