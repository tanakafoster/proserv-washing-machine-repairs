---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LongFormSection from '../../components/LongFormSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import LinkCards from '../../components/LinkCards.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import { articleSchema, faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}/`;
const modified = post.data.updatedDate ?? post.data.pubDate;
const others = (await getCollection('blog')).filter((p) => p.id !== post.id);
const fmt = (d: Date) => d.toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' });
// The post's FAQs, from its front matter. A post without any gets no FAQ section and no FAQPage schema.
const faqs = post.data.faqs ?? [];
---
<BaseLayout
  title={post.data.metaTitle}
  description={post.data.description}
  crumbs={[{ name: 'Blog', href: '/blog/' }, { name: post.data.title, href: path }]}
  schema={[articleSchema({ title: post.data.title, description: post.data.description, path, image: post.data.image, published: post.data.pubDate, modified }), ...(faqs.length ? [faqSchema(faqs)] : [])]}
  ogType="article"
  article={{ published: post.data.pubDate, modified }}
  preloadImage={{ src: post.data.image }}
>
  <article>
    <PageHero
      h1={post.data.title}
      eyebrow="Blog"
      image={{ src: post.data.image, alt: post.data.imageAlt, width: 960, height: 540 }}
      actions={false}
      trust={false}
    >
      <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-soft">
        <span class="inline-flex items-center gap-2"><Icon name="book" class="h-4 w-4 text-brand" /> By ProServ</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{fmt(post.data.pubDate)}</time>
        {post.data.updatedDate && <><span aria-hidden="true">·</span> <span>Updated <time datetime={post.data.updatedDate.toISOString().slice(0, 10)}>{fmt(post.data.updatedDate)}</time></span></>}
      </p>
    </PageHero>
    <LongFormSection reservedIds={['more-posts']} bookingHeading="Need a technician?">
      <Content />
    </LongFormSection>
  </article>
  <LinkCards
    alt
    cols={3}
    eyebrow="Blog"
    heading="More from the blog"
    headingId="more-posts"
    icon="book"
    items={others.map((o) => ({ href: `/blog/${o.id}/`, title: o.data.title, text: o.data.summary }))}
  />
  {faqs.length > 0 && <Faq items={faqs} tone="white" />}
  <CtaBand />
</BaseLayout>
