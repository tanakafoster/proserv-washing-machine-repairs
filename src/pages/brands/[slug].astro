---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LongFormSection from '../../components/LongFormSection.astro';
import AsideLinks from '../../components/AsideLinks.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import LinkCards from '../../components/LinkCards.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import { brands, type Brand } from '../../data/brands';
import { site, brandUrl, errorCodeUrl, areaUrl } from '../../data/site';
import { serviceSchema, faqSchema } from '../../lib/schema';

export function getStaticPaths() {
  return brands.map((b) => ({ params: { slug: `${b.slug}-washing-machine-repairs` }, props: { b } }));
}
const { b } = Astro.props as { b: Brand };
const path = brandUrl(b.slug);
const others = brands.filter((o) => o.slug !== b.slug);
---
<BaseLayout
  title={b.title}
  description={b.description}
  crumbs={[{ name: 'Brands', href: '/brands/' }, { name: b.brand, href: path }]}
  schema={[serviceSchema({ name: `${b.brand} washing machine repairs`, description: b.description, path }), faqSchema(b.faqs)]}
>
  <PageHero h1={b.h1} intro={b.intro} eyebrow="Brands we repair" />
  <LongFormSection reservedIds={['areas-h', 'other-brands']} bookingHeading={`Book your ${b.brand} repair`}>
    <Fragment set:html={b.body} />
    {b.hasErrorGuide && (
      <Fragment slot="aside">
        <AsideLinks
          heading={`${b.brand} error code guide`}
          intro={`What the codes on your ${b.brand} display mean and what to check first.`}
          items={[{ href: errorCodeUrl(b.slug), title: `${b.brand} washing machine error codes`, icon: 'alert' }]}
        />
      </Fragment>
    )}
  </LongFormSection>
  <HowItWorks tone="surface" />
  <LinkCards
    variant="compact"
    icon="map"
    eyebrow="Areas we cover"
    heading={`${b.brand} repairs across Gauteng`}
    headingId="areas-h"
    items={site.areas.map((a) => ({ href: areaUrl(a.slug), kicker: 'Washing machine repairs', title: a.name }))}
  />
  <LinkCards
    alt
    variant="chips"
    eyebrow="More brands"
    heading="Other brands we repair"
    headingId="other-brands"
    items={others.map((o) => ({ href: brandUrl(o.slug), title: o.brand }))}
  />
  <Faq items={b.faqs} heading={`${b.brand} washing machine repair questions`} tone="white" />
  <CtaBand heading={`${b.brand} washing machine playing up?`} />
</BaseLayout>
