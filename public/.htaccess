# ProServ — Apache / cPanel configuration
# Upload the contents of dist/ (including this file) to public_html.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Force https and non-www in a single 301 hop
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://proservwashingmachinerepairs.co.za/$1 [R=301,L]

  # 2) Strip /index.html from URLs
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # 3) Add a trailing slash to directory-style URLs (consistent trailing slashes)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# Real 404 status with the custom page
ErrorDocument 404 /404.html

# Keep /thank-you/ out of search results (also set via meta robots).
# Don't block it in robots.txt: Google has to be able to crawl the page to see the noindex.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/thank-you/#">
    Header set X-Robots-Tag "noindex, follow"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Caching: hashed build assets forever, images a month, HTML always revalidated
# Some hosts don't map .woff2 to a type, which would skip the font rule below.
AddType font/woff2 .woff2
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
# Files in /_astro/ have a content hash in their name, so they can be cached for good.
# (<FilesMatch> only sees the file name, not the folder, so the path is tested with <If>.)
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>
